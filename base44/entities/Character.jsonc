{
  "name": "Character",
  "type": "object",
  "properties": {
    "student_email": { "type": "string", "description": "Email do aluno dono do personagem" },
    "student_name": { "type": "string" },
    "profession": { "type": "string", "description": "ID da profissão dos sonhos" },
    "profession_label": { "type": "string" },
    "avatar_emoji": { "type": "string", "default": "🦊" },
    "color": { "type": "string", "default": "from-violet-500 to-indigo-500" },
    "level": { "type": "number", "default": 1 },
    "xp": { "type": "number", "default": 0 },
    "coins": { "type": "number", "default": 0 },
    "diamonds": { "type": "number", "default": 0 },
    "stars": { "type": "number", "default": 0 },
    "unlocked_cities": { "type": "array", "items": { "type": "string" }, "description": "Cidades já desbloqueadas" },
    "unlocked_avatars": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["student_email","profession"]
}
